# ============================================================================
# SANKOR silo — environment. Copy to `.env` (install.sh does this for you) and
# keep it OUT of git. The secret/key block is generated by ../lib/gen-keys.sh;
# the rest you fill in from your SANKOR hub + domain.
# ============================================================================

# ---- Generated secrets (run: bash lib/gen-keys.sh) -------------------------
# JWT_SECRET is the ONE value the whole silo trusts: the mint function signs
# with it and PostgREST validates with it. ANON_KEY / SERVICE_ROLE_KEY are HS256
# JWTs derived from it — regenerate all together, never separately.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=

# ---- This silo's identity + hub link (from the SANKOR admin) ---------------
# Your website id (uuid) as shown in the SANKOR hub. Must match byoi_config.
SANKOR_SITE_WEBSITE_ID=
# The SANKOR hub's Supabase URL, e.g. https://hub.sankor.site
SANKOR_HUB_URL=
# The hub's anon/publishable key (used only to call the redeem RPC).
SANKOR_HUB_ANON_KEY=
# Minted-token lifetime in seconds (default 900 = 15 min).
SANKOR_TOKEN_TTL_SECONDS=900

# ---- Public address --------------------------------------------------------
# The domain this silo is served on (Caddy gets a TLS cert for it). For local
# testing use http://localhost. Register this URL + ANON_KEY in the SANKOR admin.
SILO_DOMAIN=

# ---- Full stack only: Studio admin UI login --------------------------------
# Caddy basic-auth for the Studio UI at the root. Generate the hash with:
#   docker run --rm caddy:2.8 caddy hash-password --plaintext 'your-password'
STUDIO_USER=admin
STUDIO_PASSWORD_HASH=

# ---- Optional: AI blogging agent (ai-agent-run) ----------------------------
GEMINI_API_KEY=
AI_AGENT_CRON_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
