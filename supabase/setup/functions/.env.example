# ============================================================================
# SANKOR-BYOI silo — edge function secrets
# ----------------------------------------------------------------------------
# Set these on your silo Supabase project, NOT in this repo:
#   Dashboard → Edge Functions → Manage Secrets
#   or:  supabase secrets set --env-file supabase/setup/functions/.env
# Copy this file to `.env`, fill in real values, and keep `.env` out of git.
# ============================================================================

# ---- authenticate-sankor-user (required) -----------------------------------
# The HS256 secret that signs silo tokens. Generate: openssl rand -base64 48
# This exact value must ALSO be set as the project's JWT secret (see README §2).
SANKOR_SITE_JWT_SECRET=

# This silo's website id (uuid, from the SANKOR hub). Must equal byoi_config.website_id.
SANKOR_SITE_WEBSITE_ID=

# The SANKOR hub's Supabase project URL, e.g. https://xxxx.supabase.co
SANKOR_HUB_URL=

# The hub's publishable/anon key (used only to call the redeem RPC).
SANKOR_HUB_ANON_KEY=

# Only when using the "JWT Signing Keys" slot (README §2, option B): the shared
# secret key's Key ID. Leave empty to use the Legacy JWT Secret slot.
SANKOR_SITE_JWT_KID=

# Optional. Minted-token lifetime in seconds (default 900 = 15 min).
SANKOR_TOKEN_TTL_SECONDS=900

# ---- ai-agent-run (optional — only if you enable the AI blogging agent) -----
# The tenant's own Gemini API key (true BYOI).
GEMINI_API_KEY=

# Shared secret; must match the value in the pg_cron schedule (overlay §AI Agent).
AI_AGENT_CRON_SECRET=

# Optional AI-cover uploads to Cloudflare R2 (leave unset to skip covers).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
